<div class="flex justify-center bg-gray-200 w-full">
  <div class="w-full max-w-6xl px-4 bg-gray-200">
  
<div class="flex justify-between items-center mb-6 mt-8">
      <div class="flex items-center w-full">
        <h1 class="text-2xl font-bold text-gray-500">GLOSARIUM</h1>
        <div class="flex-grow mx-3 border-t border-gray-300"></div> <!-- Line -->
      </div>
      <div class="flex space-x-4">
        <!-- Edit Button -->
        <%= link_to edit_admin_content_path(@content), class: "text-black-600 hover:text-black-800" do %>
          <%= image_tag 'edit.png', class: "h-6 w-6" %>
        <% end %>

        <!-- Delete Button -->
        <%= button_to admin_content_path(@content), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800" do %>
          <%= image_tag 'delete.png', class: "h-6 w-6" %>
        <% end %>
      </div>
    </div>

    <!-- Content Section (Football Field + Glossary) -->
    <div class="flex p-6 space-x-6 items-start w-full bg-white rounded-lg shadow-lg">
      <!-- Left Side: Football Field Image -->
      <div class="w-1/3">
        <%= image_tag 'Gelos.png', class: "rounded-md w-full object-cover shadow-lg" %>
      </div>

      <!-- Right Side: Glossary Content in White Box -->
      <div class="flex-grow bg-white p-6 rounded-lg shadow-inner w-full">
        <h3 class="text-lg font-semibold text-gray-800 mb-3"><%= @content.title %></h3>
        <div class="text-gray-800 leading-relaxed space-y-2">
          <%= @content.content.html_safe %>
        </div>
      </div>
    </div>
  </div>
</div>
