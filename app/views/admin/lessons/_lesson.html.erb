<div class="w-full">
  <!-- Container with shadow and rounded edges -->
  <div id="<%= dom_id(@lesson) %>" class="w-full bg-gray-100 p-6 rounded-lg shadow-lg hover:shadow-xl duration-300">
    
    <!-- Header Section with Title and Add Button -->
    <div class="flex justify-between items-center mb-4">
      <h2 class="font-bold text-xl text-gray-800">GLOSARIUM</h2>
      <%= link_to "Tambah", new_admin_lesson_content_path(@lesson), class: "bg-gray-200 text-black py-2 px-4 rounded hover:bg-gray-300 transition duration-200" %>
    </div>

    <!-- List of Contents -->
    <div class="space-y-4">
      <% @contents.each do |content| %>
        <div class="flex items-center justify-between bg-white p-4 rounded-lg shadow-sm">
          
          <!-- Content Image and Title Section wrapped in a link to make it clickable -->
          <div class="flex items-center">
            <%= link_to admin_content_path(content), class: "flex items-center" do %>
              <% if content.image.attached? %>
                <%= image_tag(content.image, class: "h-16 w-16 object-cover rounded") %>
              <% else %>
                <%= image_tag "Gelos.png", class: "h-16 w-16 object-cover rounded" %>
              <% end %>
              <h3 class="ml-4 font-bold text-lg text-gray-800"><%= content.title %></h3>
            <% end %>
          </div>

          <!-- Action Buttons Section -->
          <div class="flex space-x-4">
            <!-- Edit Button -->
            <%= link_to edit_admin_content_path(content), class: "text-blue-600 hover:text-blue-800" do %>
              <%= image_tag 'edit.png', class: "h-6 w-6" %>
            <% end %>
            <!-- Delete Button -->
            <%= button_to admin_content_path(content), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800" do %>
              <%= image_tag 'delete.png', class: "h-6 w-6" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Bottom Navigation Links -->
    <div class="mt-6 flex justify-end space-x-4">
      <%= link_to "Back to lessons", admin_lessons_path, class: "text-blue-600 hover:underline transition duration-200" %>
      <%= link_to "Edit", edit_admin_lesson_path(@lesson), class: "text-blue-600 hover:underline transition duration-200" %>
      <%= button_to "Destroy this lesson", admin_lesson_path(@lesson), method: :delete, class: "text-blue-600 hover:underline transition duration-200" %>
    </div>
  </div>
</div>
