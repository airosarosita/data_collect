<p class="text-green-500 mb-4"><%= notice %></p>

<div class="bg-white p-6 rounded-lg shadow-md">
    <h2 class="text-2xl font-semibold mb-4"><%= @test.title %></h2>
    <p class="text-gray-700 mb-4"><%= @test.description %></p>

    <div class="flex space-x-4 mt-6">
        <%= link_to "Edit this test", edit_admin_test_path(@test), class: "text-blue-600 hover:text-blue-800" %> |
        <%= link_to "Back to tests", admin_tests_path, class: "text-gray-600 hover:text-gray-800" %> |
        <%= button_to "Destroy this test", admin_test_path(@test), method: :delete, class: "text-red-600 hover:text-red-800" %>
    </div>
</div>