<div class="flex flex-col md:flex-row min-h-screen bg-white">
    <!-- Main content with welcome message and test button -->
    <div class="flex-1 p-4 md:p-8">
        <div class="text-left p-6 rounded-lg mb-6">
            <h1 class="text-3xl font-bold mb-4">
                Selamat Datang di <span style="color: #23A50A;">Lapangbola</span> Football Data Collect!
            </h1>
            <p class="text-lg mb-4">
                Ikuti tes pemahaman, dan kembangkan diri Anda menjadi seorang data collector sepak bola yang handal.
            </p>
            <!-- Link to start the test, assuming you have a test_path -->
            <%= link_to 'Mulai Test...', client_test_path(@tests), class: 'font-semibold text-lg', style: 'color: #23A50A;' %>

        </div>
    </div>

    <!-- Image section (right side for the player image) -->
    <div class="hidden md:block w-full md:w-1/2 flex items-center justify-center">
        <div class="relative">
            <!-- Circle decoration behind the player using the uploaded image -->
            <div class="absolute inset-0 flex items-center justify-center">
                <img src="<%= asset_path 'gambar_4.png' %>" alt="Green Circle" class="w-96 h-96">
            </div>
            <!-- Player image -->
            <img src="<%= asset_path 'gambar3.png' %>" alt="Football Player" class="relative z-5 h-auto">
        </div>
    </div>
</div>