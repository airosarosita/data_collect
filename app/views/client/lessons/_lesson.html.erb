<div class="w-3/4 mx-auto p-8 mt-10 flex flex-col space-y-6">
    <!-- Title -->
    <h1 class="text-2xl font-bold text-gray-900 text-center">Glosarium Praktis dan Hebat</h1>

    <!-- Grid of contents -->
    <div id="<%= dom_id(@lesson) %>" class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        <% @contents.each do |content| %>
        <div class="border border-gray-300 rounded-lg p-4 shadow-md hover:shadow-lg transition-shadow duration-300 bg-white">
            <!-- Content Image -->
            <img src="<%= image_path('Definisi1.png') %>" alt="<%= content.title %>" class="w-full h-40 object-cover rounded-md">

            <!-- Content Title -->
            <h3 class="text-lg font-semibold text-gray-900 my-2"><%= content.title %></h3>

            <!-- Content Body (truncated) -->
            <p class="text-sm text-gray-700 mb-4"><%= truncate(content.content, length: 100) %></p>

            <!-- Content Rating and Comments (Optional) -->
            <div class="flex items-center justify-between text-gray-600 text-sm">
                <span>🗨️: 4</span>
                <span>⭐: 4.8/5</span>
            </div>

            <!-- View Content Link -->
            <%= link_to "View Content", client_content_path(content), class: "text-blue-500 hover:underline mt-4 inline-block" %>
        </div>
        <% end %>
    </div>

    <!-- Back to Lessons -->
    <div class="flex justify-end mt-6">
        <%= link_to "Back to lessons", client_lessons_path, class: "text-blue-600 hover:underline transition duration-200" %>
    </div>
</div>