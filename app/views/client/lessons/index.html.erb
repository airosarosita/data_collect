<div class="flex justify-center">
    <div class="w-full max-w-6xl p-6">

        <!-- Welcome Section -->
        <div class="flex flex-col sm:flex-row items-center justify-between mb-8">
            <!-- Image -->
            <div class="w-full sm:w-1/2 p-4">
                <%= image_tag "Frame6.png", alt: "Welcome Image", class: " h-auto object-cover" %>
            </div>

            <!-- Welcome Text -->
            <div class="w-full sm:w-1/2 p-2 text-center sm:text-left">
                <h1 class="text-2xl font-bold text-gray-800">
                    Selamat Datang di <span class="text-green-600">Lapangbola</span> Football Data Collect!
                </h1>
                <p class="mt-4 text-gray-600">
                    Ikuti tes pemahaman, dan kembangkan diri Anda menjadi seorang data collector sepak bola yang handal.
                </p>
            </div>
        </div>

        <!-- E-Learning Section -->
        <div class="text-center mb-4">
            <h1 class="text-3xl font-bold text-gray-800">E-Learning</h1>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @lessons.each do |lesson| %>
            <div class="border border-gray-200 p-4 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
                <div class="relative">
                    <%= image_tag "Frame8.png", alt: "Lesson Image", class: "w-full h-48 object-cover rounded-t-lg" %>
                    <div class="absolute top-2 left-2 text-black px-2 py-1 text-xs font-bold rounded" style="background-color: #ffffff;">Lapangbola</div>
                    <div class="absolute top-2 right-2 text-white px-2 py-1 text-xs font-bold rounded" style="background-color: #23A20B;">Data Collect</div>
                </div>

                <div class="p-4">
                    <h2 class="font-bold text-lg text-gray-800 mb-2"><%= lesson.title %></h2>
                    <%= link_to "Lihat Selengkapnya", client_lesson_path(lesson), class: "text-white px-4 py-2 rounded font-bold inline-block", style: "background-color: #23A20B;" %>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>