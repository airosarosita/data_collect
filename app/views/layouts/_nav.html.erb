<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <title>E-Learning System</title>
  <style>
    body {
      padding-top: 4rem;
    }
    .main-content {
      margin-left: 20%;
    }
    .sidebar {
      margin-left: 0;
    }
    .main-content-with-sidebar {
      margin-left: 20%;
    }
  </style>
</head>

<body>
  <!-- Top Navigation Bar -->
  <nav class="fixed top-0 left-0 w-full" style="background-color: #ffffff;>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <!-- Logo -->
        <div class="text-1xl text-black font-bold">
          <%= link_to root_path, class: "hover:font-bold text-black flex items-center" do %>
            <img src="<%= asset_path('logo1.png') %>" alt="Logo" class="h-13">
            <div>
              <span class="block">E-Learning System</span>
            </div>
          <% end %>
        </div>      

        <!-- User Authentication Links -->
        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <!-- Admin Navbar -->
              <%= link_to edit_user_registration_path, class: "text-black hover:bg-white-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
                <i class="fas fa-user"></i> Profile
              <% end %>
              <%= link_to admin_dashboards_path, class: "text-black hover:bg-white-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
                <i class="fas fa-cogs"></i> Admin Dashboard
              <% end %>
              <%= link_to destroy_user_session_path, method: :delete, class: "text-black hover:bg-wihte-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
                <i class="fas fa-sign-out-alt"></i> Logout
              <% end %>
            <% else %>
              <!-- Client Navbar -->
              <%= link_to edit_user_registration_path, class: "text-black hover:bg-white-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
                <i class="fas fa-user"></i> Profile
              <% end %>
              <%= link_to destroy_user_session_path, method: :delete, class: "text-black hover:bg-white-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
                <i class="fas fa-sign-out-alt"></i> Logout
              <% end %>
            <% end %>
          <% else %>
            <!-- Guest Navbar -->
            <%= link_to new_user_session_path, class: "text-black hover:bg-white-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
              <i class="fas fa-sign-in-alt"></i> Login
            <% end %>
            <%= link_to new_user_registration_path, class: "text-black hover:bg-white-600 rounded-lg px-3 py-2 transition-colors duration-300" do %>
              <i class="fas fa-user-plus"></i> Sign up
            <% end %>
          <% end %>
        </div>
      </div>
    </div>